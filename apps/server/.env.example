# Généré par `bun run local:setup` dans apps/server/.env (jamais versionné).
PORT=4100
# Login membre de sentinel_ingest : insère des événements, rien d'autre.
INGEST_DATABASE_URL=postgresql://sentinel_ingest_login:MOT_DE_PASSE@127.0.0.1:5432/sentinel
# Login membre de sentinel_app : lit les événements, gère partitions, alertes et incidents.
APP_DATABASE_URL=postgresql://sentinel_app_login:MOT_DE_PASSE@127.0.0.1:5432/sentinel
# Secret(s) HMAC partagés avec l'émetteur de Vortex (64 caractères hexadécimaux), séparés par une virgule pendant une rotation.
INGEST_SECRETS=
# Points de santé interrogés toutes les 30 s, au format nom=url, séparés par des virgules.
PROBE_TARGETS=vortex-api=http://127.0.0.1:3001/api/v1/health
# Hôtes dont le certificat TLS est vérifié chaque jour (hôte ou hôte:port). Vide en local.
TLS_TARGETS=
# Systèmes de fichiers surveillés toutes les 5 min (chemins absolus).
DISK_PATHS=/
# Clé AES-256 des secrets de double authentification des opérateurs (openssl rand -hex 32). La changer rend les codes
# déjà enrôlés inutilisables : chaque opérateur devra réactiver sa double authentification.
OPERATOR_SECRET_KEY=
# Origine du tableau de bord : seule autorisée à écrire (connexion, transitions). https en production.
DASHBOARD_ORIGIN=http://localhost:4100
