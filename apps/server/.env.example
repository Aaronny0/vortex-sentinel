# Généré par `bun run local:setup` dans apps/server/.env (jamais versionné).
PORT=4100
# Login membre de sentinel_ingest : insère des événements, rien d'autre.
INGEST_DATABASE_URL=postgresql://sentinel_ingest_login:MOT_DE_PASSE@127.0.0.1:5432/sentinel
# Login membre de sentinel_app : lit les événements, gère partitions, alertes et incidents.
APP_DATABASE_URL=postgresql://sentinel_app_login:MOT_DE_PASSE@127.0.0.1:5432/sentinel
# Secret(s) HMAC partagés avec l'émetteur de Vortex (64 caractères hexadécimaux), séparés par une virgule pendant une rotation.
INGEST_SECRETS=
